{
  "position": "bottom",
  "layer": "top",
  "spacing": 8,
  "margin-bottom": 10,
  "margin-left": 12,
  "margin-right": 12,

  "modules-center": [
    "custom/launcher",
    "custom/wallpaper",
    "custom/theme",
    "hyprland/workspaces",
    "clock",
    "pulseaudio",
    "network",
    "battery",
    "custom/caffeine",
    "custom/notifications",
    "custom/updatetoggler",
    "custom/power"
  ],

  "custom/launcher": {
    "exec": "~/.config/waybar/os-icon.sh",
    "interval": "once",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "App Launcher",
    "on-click": "~/.config/rofi/launcher.sh"
  },

  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip": true,
    "tooltip-format": "Switch Wallpaper",
    "on-click": "~/.config/hypr/scripts/wallpaper-switch.sh"
  },

  "custom/theme": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Switch Color Theme",
    "on-click": "~/.config/hypr/scripts/theme-switcher.sh"
  },

  "custom/updatetoggler": {
    "format": "󰨇",
    "tooltip": true,
    "tooltip-format": "System Update",
    "on-click": "~/.config/waybar/scripts/system-update.sh"
  },

  "clock": {
    "interval": 60,
    "format": " {:%I:%M %p}",
    "format-alt": "󰃭 {:%a, %d %b}",
    "tooltip-format": "<tt><span size='12pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#e2e2e2'><b>{}</b></span>",
        "days": "<span color='#e2e2e2'>{}</span>",
        "today": "<span color='#131313' background='#e2e2e2'><b>{}</b></span>"
      }
    }
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": 5
    },
    "format": "{icon}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": " {volume}%",
    "format-icons": {
      "default": ["", ""],
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": ""
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip-format": "{desc}\nVolume: {volume}%"
  },

  "network": {
    "format": "{ifname}",
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰊗",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/.config/hypr/scripts/wifi-manager.sh"
  },

  "battery": {
    "states": {
      "middle": 40,
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/caffeine": {
    "return-type": "json",
    "format": "{text}",
    "tooltip": "{tooltip}",
    "exec": "~/.config/waybar/scripts/caffeine-status.sh",
    "interval": 5,
    "on-click": "~/.config/hypr/scripts/caffeine-mode.sh"
  },

  "custom/notifications": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Notifications",
    "on-click": "swaync-client -t"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/hypr/scripts/power-menu.sh"
  }
}