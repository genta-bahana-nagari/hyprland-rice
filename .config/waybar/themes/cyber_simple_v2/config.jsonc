{
  "spacing": 15,
  "margin-top": 10,
  "margin-left": 15,
  "margin-right": 15,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "battery"],

  "clock": {
    "interval": 60,
    "format": "󰃭 {:%A, %B %d  |  󰥔 %I:%M %p}",
    "format-alt": "󰥔 {:%I:%M %p}",
    "tooltip-format": "<tt><span size='12pt' font='JetBrainsMono Nerd Font'>{calendar}</span></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#00f0ff'><b>{}</b></span>",
        "days": "<span color='#e0e0ff'>{}</span>",
        "today": "<span color='#05050a' background='#00f0ff'><b>{}</b></span>",
      },
    },
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "default": "",
      "active": "",
      "urgent": "",
    },
  },

  "network": {
    "format": "{ifname}",
    "format-wifi": "{essid} ",
    "format-ethernet": "󰊗",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "Ethernet Connected",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 25,
    "on-click": "~/.config/hypr/scripts/wifi-manager.sh",
  },

  "battery": {
    "states": {
      "middle": 40,
      "warning": 20,
      "critical": 10,
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󱐋",
    "format-plugged": "",
    "format-icons": ["", "", "", "", ""],
  },
}
