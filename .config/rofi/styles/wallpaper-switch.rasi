@import "../shared/colors.rasi"
@import "../shared/fonts.rasi"

/*****----- Configuration -----*****/
configuration {
    modi: "drun";
    show-icons: true;
}

/*****----- Window -----*****/
window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;

    width: 75%;
    height: 55%;

    border: 2px;
    border-radius: 16px;
    border-color: @selected;

    background-color: @background;

    padding: 0px;
    margin: 0px;

    enabled: true;
    cursor: "default";
}

/*****----- Mainbox -----*****/
mainbox {
    enabled: true;
    orientation: vertical;

    spacing: 12px;
    margin: 0px;
    padding: 18px;

    border-radius: 16px;
    background-color: transparent;

    children: [
        "inputbar",
        "listview"
    ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled: true;

    spacing: 10px;
    margin: 0px;
    padding: 12px 14px;

    border: 1px;
    border-radius: 10px;
    border-color: @selected;

    background-color: @background-alt;
    text-color: @foreground;

    children: [
        "prompt",
        "entry"
    ];
}

/*****----- Prompt -----*****/
prompt {
    enabled: true;
    background-color: transparent;
    text-color: @selected;
}

/*****----- Entry -----*****/
entry {
    enabled: true;
    background-color: transparent;
    text-color: @foreground;

    cursor: text;

    placeholder: "Search wallpaper...";
    placeholder-color: @foreground;
}

/*****----- Listview -----*****/
listview {
    enabled: true;

    columns: 6;
    lines: 3;

    flow: horizontal;

    spacing: 12px;
    padding: 6px;

    fixed-width: true;
    fixed-height: true;

    cycle: true;
    background-color: transparent;
}

/*****----- Element -----*****/
element {
    enabled: true;
    orientation: vertical;
    spacing: 6px;
    margin: 0px;
    padding: 10px;
    border: 2px;
    border-radius: 12px;
    border-color: transparent;
    background-color: transparent;
    text-color: @foreground;
    cursor: pointer;
}

/*****----- Selected Element -----*****/
element selected.normal {
    background-color: transparent;
    border-color: @foreground;
    text-color: @foreground;
}

/*****----- Element Icon -----*****/
element-icon {
    enabled: true;
    size: 35%;
    margin: 5px;

    background-color: transparent;
    text-color: inherit;

    cursor: inherit;
}

/*****----- Element Text -----*****/
element-text {
    enabled: true;

    vertical-align: 0.5;
    horizontal-align: 0.5;

    padding: 4px;
    margin: 0px;

    background-color: transparent;
    text-color: inherit;

    cursor: inherit;
}