{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "right": 4,
    },
    "color": {
      "1": "white",
    },
  },

  "display": {
    "separator": "  │ ",
  },

  "modules": [
    "break",

    {
      "type": "os",
      "key": "",
      "keyColor": "white",
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "white",
    },
    {
      "type": "uptime",
      "key": "",
      "keyColor": "white",
    },

    {
      "type": "wm",
      "key": "",
      "keyColor": "white",
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "white",
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "white",
    },

    {
      "type": "cpu",
      "format": "{1}",
      "key": "",
      "keyColor": "white",
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "󰘚",
      "keyColor": "white",
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "white",
    },

    {
      "type": "disk",
      "key": "",
      "keyColor": "white",
    },
    {
      "type": "battery",
      "key": "",
      "keyColor": "white",
    },

    "break",
  ],
}
