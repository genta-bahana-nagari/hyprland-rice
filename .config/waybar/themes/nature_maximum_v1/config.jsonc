{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "margin": 0,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "cpu",
    "memory",
    "temperature",
    "disk",
    "hyprland/window",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "custom/caffeine",
    "custom/updates",
    "backlight",
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "custom/power",
  ],

  "custom/launcher": {
    "format": "FIELD",
    "tooltip": true,
    "tooltip-format": "Open Field Manual",
    "on-click": "~/.config/rofi/launcher.sh",
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": { "active": "■", "default": "□", "urgent": "▲" },
  },
  "hyprland/window": {
    "format": " {title}",
    "max-length": 30,
    "tooltip": false,
  },

  "cpu": {
    "format": "CPU {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}",
  },
  "memory": {
    "format": "RAM {}%",
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)\nSwap: {swapUsed:0.1f}GB",
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "TEMP {temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "Core Temperature: {temperatureC}°C",
  },
  "disk": {
    "format": "DISK {percentage_used}%",
    "tooltip": true,
    "tooltip-format": "Disk: {used} used out of {total}\nFree Space: {free}\nPath: {path}",
  },

  "clock": {
    "format": "{:%H:%M:%S  |  %a %d %b %Y}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
  },

  "tray": {
    "icon-size": 14,
    "spacing": 10,
  },
  "custom/caffeine": {
    "return-type": "json",
    "format": "{text}",
    "tooltip": "{tooltip}",
    "exec": "~/.config/waybar/scripts/caffeine-status.sh",
    "interval": 5,
    "on-click": "~/.config/hypr/scripts/caffeine-mode.sh",
  },
  "custom/updates": {
    "format": "UPD",
    "tooltip": true,
    "tooltip-format": "System Update",
    "on-click": "~/.config/waybar/scripts/system-update.sh",
  },
  "backlight": {
    "format": "LUX {percent}%",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
  },
  "pulseaudio": {
    "format": "AUD {volume}%",
    "format-muted": "AUD MUTED",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}",
  },
  "network": {
    "format-wifi": "NET {signalStrength}%",
    "format-ethernet": "NET LAN",
    "format-disconnected": "NET OFFLINE",
    "tooltip-format-wifi": "SSID: {essid}\nStrength: {signalStrength}%\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-disconnected": "Network Disconnected",
  },
  "bluetooth": {
    "format": "BT {status}",
    "tooltip-format": "Bluetooth: {status}\n{num_connections} connected",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
  },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "PWR {capacity}%",
    "format-charging": "PWR {capacity}% CHG",
    "tooltip": true,
    "tooltip-format": "Time left: {time}\nHealth: {health}%\nCycles: {cycles}",
  },
  "custom/power": {
    "format": "OFF",
    "tooltip": true,
    "tooltip-format": "System Menu",
    "on-click": "~/.config/hypr/scripts/power-menu.sh",
  },
}
