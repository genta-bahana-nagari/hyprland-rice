{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 14,
    "margin-left": 40,
    "margin-right": 40,
    "modules-left": ["group/left-cluster"],
    "modules-center": ["group/center-cluster"],
    "modules-right": ["group/right-cluster"],
    "group/left-cluster": {"orientation": "horizontal", "spacing": 2, "modules": ["hyprland/workspaces", "custom/sep1", "cpu", "custom/sep2", "memory"]},
    "group/center-cluster": {"orientation": "horizontal", "spacing": 0, "modules": ["clock"]},
    "group/right-cluster": {"orientation": "horizontal", "spacing": 2, "modules": ["custom/wallpaper", "custom/sep3", "temperature#gpu", "custom/sep4", "backlight", "custom/sep5", "wireplumber", "custom/sep6", "network", "battery"]},
    "custom/sep1": {"format": "│"}, "custom/sep2": {"format": "│"}, "custom/sep3": {"format": "│"}, "custom/sep4": {"format": "│"}, "custom/sep5": {"format": "│"}, "custom/sep6": {"format": "│"},
    "custom/wallpaper": {"format": "󰸉", "on-click": "~/.config/hypr/scripts/wallpaper-switch.sh", "tooltip": false},
    "temperature#gpu": {"thermal-zone": 5, "critical-threshold": 80, "format-critical": "{temperatureC}C ", "format": " {temperatureC}C", "tooltip": false},
    "backlight": {"device": "intel_backlight", "scroll-step": 5, "format": "{icon}", "format-icons": ["󰃞","󰃟","󰃝","󰃠"], "tooltip": true, "tooltip-format": "{percent}%"},
    "wireplumber": {"on-click": "pavucontrol", "on-click-right": "pamixer -t", "tooltip-format": "Playing at {volume}%", "scroll-step": 5, "format": "{icon}", "format-bluetooth": "{icon}", "format-muted": "󰝟", "format-icons": {"default": ["󰕿","󰖀","󰕾"]}},
    "network": {"format-wifi": "{icon}", "format-ethernet": "󰈀", "format-icons": ["󰤯","󰤟","󰤢","󰤥","󰤨"], "format-disconnected": "󰪎", "interval": 5, "tooltip-format-wifi": " {bandwidthDownBytes} |  {bandwidthUpBytes} | {essid}", "tooltip-format-disconnected": "Disconnected", "on-click": "~/.config/hypr/scripts/wifi-mananger.sh"},
    "cpu": {"interval": 1, "format": " {usage}%", "on-click": "kitty btop"},
    "memory": {"interval": 1, "format": " {percentage}%", "on-click": "kitty btop", "tooltip-format": "{used}/{total} GiB"},
    "hyprland/workspaces": {"on-click": "activate", "format": "{icon}", "format-icons": {}, "persistent-workspaces": {"*": 4}, "on-scroll-up": "hyprctl dispatch workspace e-1", "on-scroll-down": "hyprctl dispatch workspace e+1"},
    "clock": {"format": "{:%H:%M / %h %d}", "tooltip": true, "tooltip-format": "<tt>{calendar}</tt>"},
    "battery": {"bat": "BAT0", "format": "{icon} {capacity}%", "format-plugged": "", "format-icons": {"charging": ["󰢜","󰂆","󰂇","󰂈","󰢝","󰂉","󰢞","󰂊","󰂋","󰂅"], "default": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]}, "format-full": "󰂅", "format-alt": "{icon}", "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%", "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%", "interval": 5, "states": {"good": 95, "warning": 30, "critical": 15}},
    "tray": {"icon-size": 12, "spacing": 12}
}
