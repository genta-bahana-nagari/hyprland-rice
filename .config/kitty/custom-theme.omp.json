{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "accent": "blue",
    "git_bg": "magenta",
    "path_bg": "darkGray",
    "text_dark": "black",
    "text_light": "white"
  },
  "transient_prompt": {
    "newline": true,
    "template": "❯ ",
    "foreground": "p:accent"
  },
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:path_bg",
          "template": "\n╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "background": "p:accent",
          "foreground": "p:text_dark",
          "template": "{{ .Icon }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:path_bg",
          "foreground": "p:text_light",
          "options": {
            "folder_separator_icon": "/",
            "style": "full"
          },
          "template": "  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "background": "p:git_bg",
          "foreground": "p:text_dark",
          "template": "  {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "lightGreen",
          "template": "  {{ .Full }}"
        },
        {
          "type": "pnpm",
          "style": "plain",
          "foreground": "lightYellow",
          "properties": {
            "display_mode": "files",
            "extensions": ["pnpm-lock.yaml"]
          },
          "template": " 󰋁 {{ .Full }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "lightCyan",
          "properties": {
            "display_mode": "files"
          },
          "template": "  {{ .Full }}"
        },
        {
          "type": "java",
          "style": "plain",
          "foreground": "lightRed",
          "template": "  {{ .Full }}"
        },
        {
          "type": "php",
          "style": "plain",
          "foreground": "lightBlue",
          "template": "  {{ .Full }}"
        }
      ],
      "type": "prompt"
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:path_bg",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:accent",
          "properties": {
            "always_enabled": true
          },
          "template": " ❯❯ "
        }
      ]
    }
  ],
  "version": 4
}