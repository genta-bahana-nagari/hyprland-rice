{
  "position": "left",
  "layer": "top",
  "width": 44,
  "spacing": 6,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,

  "modules-left": [
    "custom/launcher",
    "clock",
    "hyprland/workspaces"
  ],

  "modules-center": [
    "custom/wallpaper",
    "custom/theme",
    "custom/updatetoggler"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "custom/notifications",
    "custom/power"
  ],

  "custom/launcher": {
    "exec": "~/.config/waybar/os-icon.sh",
    "interval": "once",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "App Launcher",
    "on-click": "~/.config/rofi/launcher.sh"
  },

  "clock": {
    "interval": 60,
    "format": "",
    "tooltip": false,
    "on-click": "pgrep -x gsimplecal > /dev/null && killall gsimplecal || gsimplecal"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": 5
    },
    "format": "{icon}"
  },

  "custom/wallpaper": {
    "format": "󰸉",
    "tooltip": true,
    "tooltip-format": "Switch Wallpaper",
    "on-click": "~/.config/hypr/scripts/wallpaper-switch.sh"
  },

  "custom/theme": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Switch Color Theme",
    "on-click": "~/.config/hypr/scripts/theme-switcher.sh"
  },

  "custom/updatetoggler": {
    "format": "󰨇",
    "tooltip": true,
    "tooltip-format": "System Update",
    "on-click": "~/.config/waybar/scripts/system-update.sh"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-bluetooth": "",
    "format-icons": {
      "default": ["", ""],
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": ""
    },
    "scroll-step": 2,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "ignored-sinks": ["Easy Effects Sink"],
    "tooltip-format": "Volume: {volume}%\n{desc}"
  },

  "network": {
    "format": "󰈀",
    "format-wifi": "",
    "format-ethernet": "󰊗",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "Ethernet: {ifname}",
    "tooltip-format-disconnected": "WiFi Disconnected",
    "on-click": "~/.config/hypr/scripts/wifi-manager.sh"
  },

  "battery": {
    "states": {
      "middle": 40,
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}",
    "format-charging": "󱐋",
    "format-plugged": "",
    "tooltip-format": "Battery: {capacity}%\n{timeTo}",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/notifications": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Notifications",
    "on-click": "swaync-client -t"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/hypr/scripts/power-menu.sh"
  }
}