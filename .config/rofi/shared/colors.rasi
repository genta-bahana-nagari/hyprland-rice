 * 
 * Colors — Wallust-generated (fallback)
 * 
 * Available Colors Schemes
 *
 * adapta    catppuccin    everforest    navy       paper
 * arc       cyberpunk     gruvbox       nord       solarized
 * black     dracula       lovelace      onedark    yousai
 *
 **/

/* Fallback colors — replaced by wallust on first run */
* {
    background:     {{ background }};
    foreground:     {{ foreground }};
    background-alt: rgba({{ foreground.rgb }}, 0.08);
    selected:       rgba({{ foreground.rgb }}, 0.16);
    border-colour:  rgba({{ foreground.rgb }}, 0.14);
    handle-colour:  rgba({{ foreground.rgb }}, 0.22);
    active:         {{ color4 }};
    urgent:         {{ color1 }};

    color0:  {{ color0 }};
    color1:  {{ color1 }};
    color2:  {{ color2 }};
    color3:  {{ color3 }};
    color4:  {{ color4 }};
    color5:  {{ color5 }};
    color6:  {{ color6 }};
    color7:  {{ color7 }};
    color8:  {{ color8 }};
    color9:  {{ color9 }};
    color10: {{ color10 }};
    color11: {{ color11 }};
    color12: {{ color12 }};
    color13: {{ color13 }};
    color14: {{ color14 }};
    color15: {{ color15 }};
}