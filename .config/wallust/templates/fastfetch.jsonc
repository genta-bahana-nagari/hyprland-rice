{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "command-raw",
    "source": ". /etc/os-release 2>/dev/null; f=~/.config/fastfetch/logos/${ID}.txt; [ ! -f \"$f\" ] && f=~/.config/fastfetch/logos/linux.txt; sed -e 's/\\$1/\\x1b[38;2;{{color4 | rgb}}m/g' -e 's/\\$2/\\x1b[38;2;{{color6 | rgb}}m/g' \"$f\"",
    "padding": {
      "top": 1,
      "right": 4
    }
  },

  "display": {
    "separator": " │ ",
    "color": {
      "separator": "#{{color8 | strip}}"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 10
    },
    "percent": {
      "type": 3
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "format": "{#bold_#{{foreground | strip}}}{user-name}{#}{#dim_white}@{#}{#{{color3 | strip}}}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#{{color8 | strip}}}──────────────────────────────{#}"
    },

    {
      "type": "os",
      "key": "┌ {icon}",
      "keyColor": "#{{color4 | strip}}",
      "format": "{3} ({12})"
    },
    {
      "type": "kernel",
      "key": "│ ",
      "keyColor": "#{{color4 | strip}}"
    },
    {
      "type": "uptime",
      "key": "└ ",
      "keyColor": "#{{color4 | strip}}"
    },

    "break",

    {
      "type": "wm",
      "key": "┌ ",
      "keyColor": "#{{color3 | strip}}"
    },
    {
      "type": "shell",
      "key": "│ ",
      "keyColor": "#{{color3 | strip}}"
    },
    {
      "type": "terminal",
      "key": "└ ",
      "keyColor": "#{{color3 | strip}}"
    },

    "break",

    {
      "type": "cpu",
      "format": "{1}",
      "key": "┌ ",
      "keyColor": "#{{color6 | strip}}"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "│ 󰘚",
      "keyColor": "#{{color6 | strip}}"
    },
    {
      "type": "memory",
      "key": "│ ",
      "keyColor": "#{{color6 | strip}}",
      "format": "{1} / {2}  {4} ({3})"
    },
    {
      "type": "disk",
      "key": "│ ",
      "keyColor": "#{{color6 | strip}}",
      "folders": "/",
      "format": "{1} / {2}  {9} ({3})"
    },
    {
      "type": "battery",
      "key": "└ ",
      "keyColor": "#{{color6 | strip}}",
      "format": "{12} ({4}) [{5}]"
    },

    "break",

    {
      "type": "custom",
      "format": "  {#{{color1 | strip}}}● {#}{#{{color2 | strip}}}● {#}{#{{color3 | strip}}}● {#}{#{{color4 | strip}}}● {#}{#{{color5 | strip}}}● {#}{#{{color6 | strip}}}●{#}"
    }
  ]
}