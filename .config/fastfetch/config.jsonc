{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "command-raw",
    "source": ". /etc/os-release 2>/dev/null; f=~/.config/fastfetch/logos/${ID}.txt; [ ! -f \"$f\" ] && f=~/.config/fastfetch/logos/linux.txt; sed -e 's/\\$1/\\x1b[36m/g' -e 's/\\$2/\\x1b[37m/g' \"$f\"",
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "color": {
    "1": "cyan",
    "2": "white"
  },

  "display": {
    "separator": " │ ",
    "color": {
      "separator": "dim_white"
    },
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "·"
      },
      "width": 10
    },
    "percent": {
      "type": 3
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "format": "{#bold_white}{user-name}{#}{#dim_white}@{#}{#3}{host-name}{#}"
    },
    {
      "type": "custom",
      "format": "{#dim_white}──────────────────────────────{#}"
    },

{
      "type": "os",
      "key": "┌ {icon}",
      "keyColor": "cyan",
      "format": "{3} ({12})"
    },
    {
      "type": "kernel",
      "key": "│ ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "└ ",
      "keyColor": "cyan"
    },

    "break",

    {
      "type": "wm",
      "key": "┌ ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "│ ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "└ ",
      "keyColor": "yellow"
    },

    "break",

    {
      "type": "cpu",
      "format": "{1}",
      "key": "┌ ",
      "keyColor": "white"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "│ 󰘚",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "│ ",
      "keyColor": "white",
      "format": "{1} / {2}  {4} ({3})"
    },
    {
      "type": "disk",
      "key": "│ ",
      "keyColor": "white",
      "folders": "/",
      "format": "{1} / {2}  {4} ({3})"
    },
    {
      "type": "battery",
      "key": "└ ",
      "keyColor": "white",
      "format": "{4} [{5}]"
    },

    "break",

    {
      "type": "custom",
      "format": "{#dim_white}  ● {#}{#white}● {#}{#cyan}● {#}{#yellow}● {#}{#dim_white}●{#}"
    }
  ]
}