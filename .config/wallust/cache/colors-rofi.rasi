    color5: {{color5 | desaturate(0.15)}};
    color6: {{color6 | desaturate(0.15)}};
    color7: {{color7}};
    color8: {{color8 | darken(0.30)}};
    color9: {{color9 | desaturate(0.15)}};
    color10: {{color10 | desaturate(0.15)}};
    color11: {{color11 | desaturate(0.15)}};
    color12: {{color12 | desaturate(0.15)}};
    color13: {{color13 | desaturate(0.15)}};
    color14: {{color14 | desaturate(0.15)}};
